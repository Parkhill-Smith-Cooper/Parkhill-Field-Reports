# ParkhillCXField configuration
#
# Copy to `.env.local` for local development (`.env.local` is gitignored), and
# set the same variables as App Service application settings in Azure.
#
# Every value below is an endpoint or a resource name. NONE of them are
# secrets: the app authenticates to Azure with a managed identity via
# DefaultAzureCredential, so there are no keys or connection strings to store
# or rotate. If you find yourself adding an `AccountKey` here, something has
# gone wrong - see "Azure setup" in the README.
#
# Locally, DefaultAzureCredential uses your Azure CLI session, so you must also
# run `az login` before starting the dev server.

# --- Cosmos DB (NoSQL API) -------------------------------------------------
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/

# Optional - these are the defaults the app uses if unset.
# COSMOS_DATABASE=parkhillcxfield
# COSMOS_PROJECTS_CONTAINER=projects
# COSMOS_OBSERVATIONS_CONTAINER=observations

# --- Blob Storage (field photos) -------------------------------------------
AZURE_STORAGE_ACCOUNT=yourstorageaccount

# Optional - default shown.
# AZURE_STORAGE_CONTAINER=field-photos

# --- Authentication (SAML 2.0 via Microsoft Entra ID) ----------------------
#
# Every value here except SESSION_SECRET comes from the Entra enterprise
# application. The IdP certificate is a *public* certificate, so it is
# configuration rather than a secret.
#
# SESSION_SECRET *is* a secret: it signs the session cookie. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# and store it as an App Service application setting (or in Key Vault).
# At least 32 characters. Changing it signs everyone out.
SESSION_SECRET=

# Public base URL of this deployment. Used to derive the SP entity id and the
# reply URL, so it must match what is registered in Entra exactly.
APP_BASE_URL=http://localhost:3000

# From Entra: Enterprise application -> Single sign-on (SAML) -> "Set up ..."
SAML_ENTRY_POINT=https://login.microsoftonline.com/<tenant-id>/saml2
SAML_LOGOUT_URL=https://login.microsoftonline.com/<tenant-id>/saml2
SAML_IDP_ISSUER=https://sts.windows.net/<tenant-id>/

# The Base64 signing certificate from the Entra federation metadata. Paste it
# either bare or as a full PEM block - both are accepted.
SAML_IDP_CERT=

# Restricts sign-in to the Parkhill tenant. The app refuses to authenticate
# anyone without this set.
PARKHILL_TENANT_ID=<tenant-id>

# Optional extra restriction on top of "tenant member, not a guest".
# Comma-separated, e.g. parkhill.com,parkhill.net. Leave blank to allow any
# non-guest account in the tenant.
SAML_ALLOWED_EMAIL_DOMAINS=

# Optional. Defaults to <APP_BASE_URL>/api/saml/metadata. Override only if IT
# wants a different Identifier (Entity ID) in Entra.
# SAML_SP_ENTITY_ID=

# Optional. By default no NameIDPolicy is requested, so Entra issues whatever
# the enterprise application is configured for. Set this only if IT requires a
# specific format, e.g.
#   urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress
# SAML_NAMEID_FORMAT=

# --- VantagePoint projects (Fabric) ------------------------------------------
# The New Project picker reads active VantagePoint projects from the data
# team's Fabric SQL endpoint (src/repositories/vantagepointRepository.ts) - the
# same source parkhill-ccr uses. Read-only; the signing-in identity (managed
# identity in Azure, `az login` locally) needs access to the Fabric workspace.
FABRIC_SQL_SERVER=
FABRIC_SQL_DATABASE=
# Optional, [schema.]table of the project sync.
# FABRIC_PROJECTS_TABLE=DT_BRZ.project

# --- AI suggestions ----------------------------------------------------------
# Potential failure causes and corrective actions come from OpenAI, called from
# the server only (src/lib/ai/suggestions.ts). Never prefix the key with
# NEXT_PUBLIC_, which would ship it to the browser.
OPENAI_API_KEY=
# Must be vision-capable: the suggestions read the field photos.
# OPENAI_MODEL=gpt-5.5
